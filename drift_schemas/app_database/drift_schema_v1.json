  "fixed_sql": [
    {
      "name": "repertoires",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"repertoires\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"pgn\" TEXT NOT NULL, \"pgn_hash\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"last_trained_at\" INTEGER NULL, \"drill_start_from\" TEXT NOT NULL DEFAULT 'move1', \"last_mode\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nodes\" (\"repertoire_id\" TEXT NOT NULL, \"node_id\" INTEGER NOT NULL, \"parent_id\" INTEGER NULL, \"ply\" INTEGER NOT NULL, \"san\" TEXT NULL, \"uci\" TEXT NULL, \"fen\" TEXT NOT NULL, \"is_user_move\" INTEGER NOT NULL CHECK (\"is_user_move\" IN (0, 1)), \"child_index\" INTEGER NOT NULL, \"why\" TEXT NULL, \"plan\" TEXT NULL, \"watch\" TEXT NULL, \"alt\" TEXT NULL, \"shapes\" TEXT NULL, \"raw_comment\" TEXT NULL, \"nags\" TEXT NULL, PRIMARY KEY (\"repertoire_id\", \"node_id\"));"
        }
      ]
    },
    {
      "name": "lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lines\" (\"repertoire_id\" TEXT NOT NULL, \"line_key\" TEXT NOT NULL, \"leaf_node_id\" INTEGER NOT NULL, \"ordinal\" INTEGER NOT NULL, \"plies\" INTEGER NOT NULL, \"user_move_count\" INTEGER NOT NULL, \"branch_ply\" INTEGER NOT NULL, \"label\" TEXT NOT NULL, \"ucis\" TEXT NOT NULL, PRIMARY KEY (\"repertoire_id\", \"line_key\"));"
        }
      ]
    },
    {
      "name": "runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"runs\" (\"id\" TEXT NOT NULL, \"repertoire_id\" TEXT NOT NULL, \"line_key\" TEXT NOT NULL, \"ucis\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"start_ply\" INTEGER NOT NULL, \"wrong_move_mode\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NOT NULL, \"local_day\" TEXT NOT NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), \"deviated\" INTEGER NOT NULL CHECK (\"deviated\" IN (0, 1)), \"graded_count\" INTEGER NOT NULL, \"credit_sum\" REAL NOT NULL, \"hint_count\" INTEGER NOT NULL, \"device_id\" TEXT NOT NULL, \"synced_at\" INTEGER NULL, \"schema\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "move_grades",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"move_grades\" (\"run_id\" TEXT NOT NULL, \"ply\" INTEGER NOT NULL, \"expected\" TEXT NOT NULL, \"accepted\" TEXT NOT NULL, \"first_attempt\" TEXT NULL, \"result\" TEXT NOT NULL, \"credit\" REAL NOT NULL, \"attempts\" INTEGER NOT NULL, \"hint_level\" INTEGER NOT NULL, \"check_cp\" INTEGER NULL, \"check_status\" TEXT NULL, PRIMARY KEY (\"run_id\", \"ply\"));"
        }
      ]
    },
    {
      "name": "deviation_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"deviation_events\" (\"run_id\" TEXT NOT NULL, \"ply\" INTEGER NOT NULL, \"deviation_uci\" TEXT NULL, \"reply_uci\" TEXT NULL, \"best_uci\" TEXT NOT NULL, \"loss_cp\" INTEGER NULL, \"passed\" INTEGER NOT NULL CHECK (\"passed\" IN (0, 1)), PRIMARY KEY (\"run_id\"));"
        }
      ]
    },
    {
      "name": "line_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"line_stats\" (\"repertoire_id\" TEXT NOT NULL, \"line_key\" TEXT NOT NULL, \"archived\" INTEGER NOT NULL CHECK (\"archived\" IN (0, 1)), \"run_count\" INTEGER NOT NULL, \"accuracy\" REAL NULL, \"last_played_at\" INTEGER NULL, \"in_weak_pool\" INTEGER NOT NULL CHECK (\"in_weak_pool\" IN (0, 1)), \"weak_clean_streak\" INTEGER NOT NULL, \"srs_state\" TEXT NOT NULL, \"srs_reps\" INTEGER NOT NULL, \"srs_ease\" REAL NOT NULL, \"srs_interval_days\" INTEGER NOT NULL, \"srs_due_day\" TEXT NULL, \"srs_lapses\" INTEGER NOT NULL, \"srs_first_seen_day\" TEXT NULL, PRIMARY KEY (\"repertoire_id\", \"line_key\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
